# Copy this file to .env.local (git-ignored) and fill in your own values.
# Restart `npx expo start` after changing it.
#
# Classroom demo only: a key inside a phone app can be extracted, so do not
# publish builds that contain it. The web build never includes the key.

# Your OpenRouter key (https://openrouter.ai/keys)
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Free models only — the name must end with ":free"
EXPO_PUBLIC_OPENROUTER_MODEL=google/gemma-4-31b-it:free
